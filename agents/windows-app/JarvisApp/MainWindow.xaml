<Window x:Class="JarvisApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Height="750" Width="500" MinHeight="550" MinWidth="420"
        Background="{StaticResource BgBase}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Rounded button style -->
        <Style x:Key="CircleBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Surface}" CornerRadius="20"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SendBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6366F1" Offset="0"/>
                                    <GradientStop Color="#FF4F46E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo -->
                    <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6366F1" Offset="0"/>
                                <GradientStop Color="#FF4F46E5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="J" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Jarvis" Foreground="{StaticResource TextPrimary}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <!-- Status dot -->
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Red}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Connecting..." FontSize="12"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Voice badge -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="12" Padding="10,4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <TextBlock x:Name="VoiceBadge" Text="Voice ON" FontSize="11"
                               Foreground="{StaticResource Green}" FontWeight="Medium"/>
                </Border>
            </Grid>
        </Border>

        <Rectangle Grid.Row="1" Fill="{StaticResource Border}"/>

        <!-- ═══ Chat ═══ -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="2" Background="{StaticResource BgBase}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel x:Name="ChatPanel" Margin="20,12,20,12">
                <TextBlock Text="Welcome to Jarvis OS" HorizontalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,8"/>
            </StackPanel>
        </ScrollViewer>

        <Rectangle Grid.Row="3" Fill="{StaticResource Border}"/>

        <!-- ═══ Input ═══ -->
        <Border Grid.Row="4" Background="{StaticResource BgSecondary}">
            <Border Margin="16,14" CornerRadius="24" Background="{StaticResource BgTertiary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MicBtn" Grid.Column="0" Style="{StaticResource CircleBtn}"
                            Content="🎤" Click="MicBtn_Click" ToolTip="Push to talk (Ctrl+Space)"/>

                    <TextBox x:Name="InputBox" Grid.Column="1" Margin="8,0"
                             FontSize="14" Foreground="{StaticResource TextPrimary}"
                             Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center" CaretBrush="{StaticResource Accent}"
                             KeyDown="InputBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Tag" Value="Message Jarvis..."/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button x:Name="SendBtn" Grid.Column="2" Style="{StaticResource SendBtn}"
                            Content="➤" Click="SendBtn_Click"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
