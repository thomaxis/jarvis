<Window x:Class="JarvisApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S." Height="800" Width="520" MinHeight="600" MinWidth="440"
        Background="#FF050510" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ═══ Colors ═══ -->
        <Color x:Key="Cyan">#FF00D4FF</Color>
        <Color x:Key="CyanDim">#FF0099CC</Color>
        <Color x:Key="CyanGlow">#4000D4FF</Color>
        <Color x:Key="ArcBlue">#FF1A8FFF</Color>
        <Color x:Key="BgDark">#FF050510</Color>
        <Color x:Key="BgPanel">#FF0A0A1A</Color>
        <Color x:Key="BgSurface">#FF0D0D20</Color>
        <Color x:Key="HudBorder">#FF0D3B5E</Color>
        <Color x:Key="HudBorderBright">#FF00D4FF</Color>
        <Color x:Key="TextWhite">#FFEAF6FF</Color>
        <Color x:Key="TextMid">#FF5A8CAA</Color>
        <Color x:Key="TextDim">#FF2A4A60</Color>
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}"/>
        <SolidColorBrush x:Key="CyanDimBrush" Color="{StaticResource CyanDim}"/>
        <SolidColorBrush x:Key="ArcBlueBrush" Color="{StaticResource ArcBlue}"/>
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
        <SolidColorBrush x:Key="HudBorderBrush" Color="{StaticResource HudBorder}"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextWhite}"/>
        <SolidColorBrush x:Key="TextMidBrush" Color="{StaticResource TextMid}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>

        <!-- ═══ Mic Button ═══ -->
        <Style x:Key="MicStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Outer glow ring -->
                            <Ellipse x:Name="glowRing" Width="48" Height="48"
                                     StrokeThickness="1.5" Opacity="0.4">
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="{StaticResource Cyan}"/>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <!-- Inner circle -->
                            <Ellipse x:Name="inner" Width="40" Height="40">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF0A1A2A" Offset="0"/>
                                        <GradientStop Color="#FF061018" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="{StaticResource CyanDim}"/>
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glowRing" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="inner" Property="Stroke" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Send Button ═══ -->
        <Style x:Key="SendStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Width="44" Height="44">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Cyan}" Offset="0"/>
                                        <GradientStop Color="{StaticResource ArcBlue}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource Cyan}" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FF050510">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!--  HEADER - HUD Style                    -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="0,0,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0A0A1A" Offset="0"/>
                    <GradientStop Color="#FF050510" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="0">
                <!-- Top HUD line -->
                <Rectangle Height="1" VerticalAlignment="Bottom" Opacity="0.3">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="{StaticResource Cyan}" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="24,16,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Arc Reactor Logo -->
                    <Grid Grid.Column="0" Width="50" Height="50" Margin="0,0,16,0">
                        <!-- Outer spinning ring -->
                        <Ellipse Width="50" Height="50" StrokeThickness="1.5" Opacity="0.5"
                                 Stroke="{StaticResource CyanDimBrush}" StrokeDashArray="2 3"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RingRotation" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- Inner ring -->
                        <Ellipse Width="38" Height="38" StrokeThickness="2" Opacity="0.7">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="{StaticResource Cyan}"/>
                            </Ellipse.Stroke>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource Cyan}" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Core -->
                        <Ellipse Width="24" Height="24">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{StaticResource Cyan}" Offset="0"/>
                                    <GradientStop Color="{StaticResource ArcBlue}" Offset="0.6"/>
                                    <GradientStop Color="#FF051525" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource Cyan}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="J" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                    </Grid>

                    <!-- Title + Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"
                                   FontFamily="Consolas" Opacity="0.95">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource Cyan}" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </TextBlock.Effect>
                            J.A.R.V.I.S.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="StatusDotFill" Color="#FFF87171"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="INITIALIZING..." FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Voice Status -->
                    <Border Grid.Column="2" CornerRadius="4" Padding="10,5"
                            BorderThickness="1" VerticalAlignment="Center">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource HudBorder}"/>
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="#0800D4FF"/>
                        </Border.Background>
                        <TextBlock x:Name="VoiceBadge" Text="VOICE: ON" FontSize="10"
                                   FontFamily="Consolas" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--  CHAT AREA                             -->
        <!-- ═══════════════════════════════════════ -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Background="#FF050510"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ChatPanel" Margin="20,8,20,8">
                <!-- Scan line decoration at top -->
                <Rectangle Height="1" Margin="40,8,40,12" Opacity="0.15">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="{StaticResource Cyan}" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="S Y S T E M   O N L I N E" HorizontalAlignment="Center"
                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════ -->
        <!--  INPUT BAR                             -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Padding="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF050510" Offset="0"/>
                    <GradientStop Color="#FF0A0A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Top HUD line -->
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource Cyan}" BlurRadius="1" ShadowDepth="0" Direction="0" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="18,14,18,18">
                <!-- Input container with HUD border -->
                <Border CornerRadius="26" Padding="6"
                        BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource HudBorder}" Offset="0"/>
                            <GradientStop Color="{StaticResource CyanDim}" Offset="0.5"/>
                            <GradientStop Color="{StaticResource HudBorder}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="#FF080818"/>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MicBtn" Grid.Column="0" Style="{StaticResource MicStyle}"
                                Content="🎤" FontSize="18" Click="MicBtn_Click"
                                ToolTip="Push to talk (Ctrl+Space)"/>

                        <TextBox x:Name="InputBox" Grid.Column="1" Margin="10,0"
                                 FontSize="14" FontFamily="Segoe UI"
                                 Foreground="{StaticResource TextWhiteBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{StaticResource CyanBrush}"
                                 KeyDown="InputBox_KeyDown"/>

                        <Button Grid.Column="2" Style="{StaticResource SendStyle}"
                                Content="➤" FontSize="16" Foreground="White"
                                Click="SendBtn_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- ═══ Animations ═══ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Spinning ring -->
                    <DoubleAnimation Storyboard.TargetName="RingRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:8"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
