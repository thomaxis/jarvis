<Application x:Class="JarvisApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#FF08080F"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#FF0D0D18"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#FF111122"/>
        <SolidColorBrush x:Key="Surface" Color="#FF13132A"/>
        <SolidColorBrush x:Key="Border" Color="#FF1E1E3D"/>
        <SolidColorBrush x:Key="Accent" Color="#FF6366F1"/>
        <SolidColorBrush x:Key="AccentDim" Color="#FF4F46E5"/>
        <SolidColorBrush x:Key="Green" Color="#FF34D399"/>
        <SolidColorBrush x:Key="Red" Color="#FFF87171"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF94A3B8"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF475569"/>
        <SolidColorBrush x:Key="UserBubble" Color="#FF1A1A40"/>
        <SolidColorBrush x:Key="JarvisBubble" Color="#FF0F1A2E"/>
        <SolidColorBrush x:Key="JarvisBorder" Color="#FF1A2A4A"/>
    </Application.Resources>
</Application>
