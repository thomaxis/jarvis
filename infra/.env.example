# Database
DATABASE_URL=postgresql+asyncpg://jarvis:your_secure_password@postgres:5432/jarvis
POSTGRES_PASSWORD=your_secure_password
REDIS_URL=redis://redis:6379/0

# Auth
JARVIS_JWT_SECRET=generate_a_long_random_secret_here

# LLM API Keys (at least one required -- free options marked with *)
GROQ_API_KEY=gsk_...                    # * Free tier: https://console.groq.com
OPENROUTER_API_KEY=sk-or-...            # * Free models: https://openrouter.ai
GEMINI_API_KEY=                         # * Free tier: https://aistudio.google.com
HF_API_KEY=hf_...                       # * Free tier: https://huggingface.co/settings/tokens
ANTHROPIC_API_KEY=sk-ant-...            #   Paid: https://console.anthropic.com
OPENAI_API_KEY=sk-...                   #   Paid: https://platform.openai.com

# TTS (optional)
ELEVENLABS_API_KEY=

# Server
DOMAIN=jarvis.yourdomain.com
LETSENCRYPT_EMAIL=you@email.com
